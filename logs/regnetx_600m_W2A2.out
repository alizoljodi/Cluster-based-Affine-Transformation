          wbit=2, abit=2, disable_act_quant=True
          (weight_quantizer): UniformAffineQuantizer(bit=2, is_training=False, inited=True)
          (act_quantizer): UniformAffineQuantizer(bit=2, is_training=False, inited=True)
          (norm_function): StraightThrough()
